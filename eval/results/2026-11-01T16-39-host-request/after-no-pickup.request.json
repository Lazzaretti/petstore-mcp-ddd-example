{
  "note": "Reduced for publication: from Claude Code's first model request, only the MCP tools and the MCP server instructions as they were sent. System prompt, user context and headers removed.",
  "body": {
    "model": "claude-haiku-5-5",
    "tools": [
      {
        "name": "mcp__petstore-discovery__find_available_pets",
        "description": "Find pets on offer, optionally by species and tag.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "species": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "e.g. dog, cat"
            },
            "tag": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "e.g. friendly, puppy, indoor"
            }
          }
        }
      },
      {
        "name": "mcp__petstore-handover__my_purchases",
        "description": "The customer's active purchases.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      {
        "name": "mcp__petstore-sales__buy_pet",
        "description": "Buy a pet for the customer.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pet_id": {
              "description": "From find_available_pets.",
              "type": "integer"
            },
            "reservation_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Optional check, from reserve_pet."
            }
          },
          "required": [
            "pet_id"
          ]
        }
      },
      {
        "name": "mcp__petstore-sales__cancel_purchase",
        "description": "Cancel a purchase: free, any time. The pet goes back on offer.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "purchase_id": {
              "description": "From buy_pet or my_purchases.",
              "type": "string"
            }
          },
          "required": [
            "purchase_id"
          ]
        }
      },
      {
        "name": "mcp__petstore-sales__reserve_pet",
        "description": "Hold a pet for the customer for 24 hours while they decide. Optional: buy_pet works without a reservation.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pet_id": {
              "description": "From find_available_pets.",
              "type": "integer"
            }
          },
          "required": [
            "pet_id"
          ]
        }
      }
    ],
    "messages": [
      {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": "# MCP Server Instructions\n\nThe following MCP servers have provided instructions for how to use their tools and resources:\n\n## petstore-discovery\nPet Discovery: find the pets the shop has on offer.\n\n## petstore-handover\nPet Handover: the signed-in customer's purchases.\n\n## petstore-sales\nPet Sales: reserve, buy and cancel purchases of pets for the signed-in customer."
          }
        ]
      }
    ]
  }
}
